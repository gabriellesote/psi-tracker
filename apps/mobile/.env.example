# apps/mobile/.env.example
#
# Copie para "apps/mobile/.env" e troque SEU_IP_LOCAL pelo IPv4 do seu computador
# (no PowerShell: ipconfig → "Endereço IPv4", algo como 192.168.0.15).
# O celular precisa estar na MESMA rede Wi-Fi do computador.
# "localhost" não funciona aqui: no celular, localhost é o próprio celular.

EXPO_PUBLIC_SUPABASE_URL=http://SEU_IP_LOCAL:54321
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=cole-aqui-a-publishable-key
EXPO_PUBLIC_API_URL=http://SEU_IP_LOCAL:3333/api
