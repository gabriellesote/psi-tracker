# .env.example
#
# Copie este arquivo para ".env" (sem o .example) e preencha.
# O .env NUNCA vai para o GitHub (está no .gitignore).
# Ele é lido pelo Docker Compose (site + API) e pela CLI do Supabase.

# Rode "npm run db:start" (ou "npm run db:status") e copie o valor de "Publishable".
SUPABASE_PUBLISHABLE_KEY=cole-aqui-a-publishable-key

# Login com Google: crie as chaves no Google Cloud (passo a passo no README,
# seção "Login com Google") e depois rode: npm run db:stop && npm run db:start
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=cole-aqui-o-client-id.apps.googleusercontent.com
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=cole-aqui-o-client-secret
